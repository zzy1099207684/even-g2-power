{
  "name": "g2-translate",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "qr": "evenhub qr --url http://$(ip -4 addr show $(ip -4 route get 1.1.1.1 | grep -oP 'dev \\K\\S+' | head -1) | grep -oP 'inet \\K[\\d.]+' | head -1):${PORT:-5173}",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "pack": "npm run build && evenhub pack app.json dist",
    "simulate": "node node_modules/@evenrealities/evenhub-simulator/bin/index.js"
  },
  "dependencies": {
    "@evenrealities/even_hub_sdk": "^0.0.10",
    "@evenrealities/pretext": "^0.1.4"
  },
  "devDependencies": {
    "@evenrealities/evenhub-cli": "^0.1.12",
    "@evenrealities/evenhub-simulator": "^0.7.2",
    "typescript": "^5.7.0",
    "vite": "^5.4.0"
  }
}
